{
  "name": "screencapture-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Monorepo for screencapture - session recording and replay with privacy controls",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @screencapture/web dev",
    "dev:web": "pnpm --filter @screencapture/web dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @screencapture/web build",
    "build:core": "pnpm --filter @screencapture/core build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "preview": "pnpm --filter @screencapture/web preview",
    "clean": "pnpm -r exec rm -rf dist node_modules"
  },
  "keywords": [
    "rrweb",
    "session-recording",
    "replay",
    "privacy",
    "pii-redaction"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
