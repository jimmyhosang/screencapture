{
  "name": "screencapture-monorepo",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "pnpm --filter @screencapture/app dev",
    "build": "pnpm --filter @screencapture/app build && pnpm --filter @screencapture/extension build",
    "build:app": "pnpm --filter @screencapture/app build",
    "build:extension": "pnpm --filter @screencapture/extension build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
