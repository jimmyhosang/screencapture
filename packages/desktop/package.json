{
  "name": "@screencapture/desktop",
  "version": "1.0.0",
  "description": "Electron desktop app for screencapture - cross-platform session recording",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm build && electron-builder --dir",
    "build:win": "pnpm build && electron-builder --win",
    "build:mac": "pnpm build && electron-builder --mac",
    "build:linux": "pnpm build && electron-builder --linux",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@screencapture/core": "workspace:*",
    "@types/uuid": "^11.0.0",
    "active-win": "^9.0.0",
    "better-sqlite3": "^11.7.0",
    "express": "^5.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "rrweb-player": "^2.0.0-alpha.4",
    "tesseract.js": "^5.1.1",
    "uiohook-napi": "^1.5.4",
    "uuid": "^13.0.0"
  },
  "optionalDependencies": {
    "@aspect-build/macos-system-ocr": "^0.1.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.6",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.15.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/coverage-v8": "^4.0.16",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~5.9.3",
    "vite": "^5.4.0",
    "vitest": "^4.0.16"
  }
}